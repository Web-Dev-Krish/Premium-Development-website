# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # KEEP SECRET — never commit this

# Resend (https://resend.com) — used to email you when a new lead comes in.
# Free tier gives you 100 emails/day and 3,000/month, which is plenty for lead alerts.
RESEND_API_KEY=re_your_resend_api_key
# Until you verify your own sending domain on Resend, you can use their shared
# "onboarding@resend.dev" address to test. Once your domain is verified, switch to
# something like: Devsiy Leads <leads@yourdomain.com>
RESEND_FROM_EMAIL=Devsiy Leads <onboarding@resend.dev>

# Optional fallback list of notification emails (comma-separated), used only if
# the "notification_emails" value isn't set in Admin Panel → Site Settings.
LEAD_NOTIFY_EMAILS=you@example.com,cofounder@example.com

# Used in the "Open in Admin Panel" link inside the lead notification email.
SITE_DOMAIN=yourdomain.com
